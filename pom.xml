    </dependency>
    <dependency>
      <groupId>org.scalacheck</groupId>
      <artifactId>scalacheck_3</artifactId>
      <version>${scalacheck.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- CycloneDX CBOM JSON-Schema validation + JSON parsing used by CBOM
         tests. The everit json-schema fork validates drafts 4/6/7 (incl.
         subschemas combining allOf/anyOf/oneOf, which the CycloneDX schemas
         use) against the org.json model — no Jackson. The spotbugs/guava
         build-era transitive cruft has no references in the validator jar
         (verified against its classes); guava is declared explicitly because
         munit builds assertion messages with ImmutableList. -->
    <dependency>
      <groupId>com.github.erosb</groupId>
      <artifactId>everit-json-schema</artifactId>
      <version>1.14.6</version>
      <scope>test</scope>
      <exclusions>
        <!-- spotbugs and the fork's accidental self-dependency are build-era
             cruft with no references in the validator jar. -->
        <exclusion>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.erosb</groupId>
          <artifactId>everit-json-schema</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
