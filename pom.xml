    <!-- Test -->
    <dependency>
      <groupId>org.scalameta</groupId>
      <artifactId>munit_3</artifactId>
      <version>${munit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.scalameta</groupId>
      <artifactId>munit-scalacheck_3</artifactId>
      <version>${munit.version}</version>
